PORT=3000
# Clients must send "Authorization: Bearer <API_KEY>"
API_KEY=change-me

# APNs key from developer.apple.com → Keys (Apple Push Notifications service)
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# or put the key contents directly (useful in Docker / Dokploy):
# APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
APNS_TOPIC=com.brenobrum.pushalarm

# Phones register themselves via POST /devices. Extra tokens to always notify (optional, comma-separated):
APNS_DEVICE_TOKENS=
# Where registered devices are stored (mount a volume here in Docker)
DATA_FILE=./data/devices.json
